# Deny-by-default publication: only independent Android source and reviewed docs.
/*
!/.gitignore
!/README.md
!/README.en.md
!/LICENSE
!/NOTICE
!/SECURITY.md
!/PRIVACY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/AndroidManifest.xml
!/android-dependencies.json
!/build.sh
!/src/
!/src/**
!/res/
!/res/**
!/native/
!/native/**
!/third_party/
!/third_party/**
!/assets/
/assets/*
!/assets/dict_pinyin.dat
!/assets/agent-prompts.json
!/assets/open-source-licenses.txt
!/scripts/
/scripts/*
!/scripts/build-pinyin.sh
!/scripts/fetch-android-deps.py
!/scripts/test-release.sh
!/scripts/test-pinyin-public.sh
!/scripts/check-publish.py
!/public-tests/
!/public-tests/**
!/docs/
!/docs/**
!/.github/
!/.github/**
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.env
**/*.keystore
**/*.jks
**/*private-key*
**/*api-key*
**/key-input-once
